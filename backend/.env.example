# Copy this file to ".env" and fill in your values. Never upload .env to GitHub.

COMPANY_NAME=RH Labs
CONTACT_WHATSAPP=+92 300 0000000
CONTACT_EMAIL=hello@example.com

# ---- AI chatbot ----
# gemini (free tier, key from https://aistudio.google.com) | groq | openai | anthropic | custom
LLM_PROVIDER=gemini
LLM_API_KEY=
# Leave empty for the default (gemini-flash-latest). For groq/openai a model name is required.
LLM_MODEL=
LLM_TIMEOUT=15

# ---- Email alerts for new project requests (Gmail) ----
# SMTP_PASSWORD must be a Gmail App Password (Google Account > Security > 2-Step Verification > App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourname@gmail.com
SMTP_PASSWORD=
NOTIFY_EMAIL=yourname@gmail.com
# true = also send a "we received your request" email to the client
SEND_AUTO_REPLY=false

# ---- Admin panel (/admin) ----
ADMIN_USER=admin
ADMIN_PASSWORD=

# ---- Database ----
# Empty = local SQLite file. For a live site use Postgres, e.g. postgresql://user:pass@host/db
DATABASE_URL=

# ---- Websites allowed to call this API (comma separated) ----
# Example when the site is on GitHub Pages: https://yourname.github.io
ALLOWED_ORIGINS=
